#!/bin/bash
# CheckFlow demo bootstrap (rendered by Terraform). Log: /var/log/checkflow-setup.log
set -uxo pipefail
exec > >(tee -a /var/log/checkflow-setup.log) 2>&1
export DEBIAN_FRONTEND=noninteractive

# 1. Session Manager agent first, so the box is reachable over SSM even if the app install fails.
snap list amazon-ssm-agent >/dev/null 2>&1 || snap install amazon-ssm-agent --classic
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service

# 2. App installer, kept on the box so it can be re-run any time:  sudo checkflow-install
#    (pulls the latest commit, reinstalls packages, restarts the service; the database is kept)
cat > /usr/local/bin/checkflow-install <<'INSTALL'
#!/bin/bash
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive HOME=/root   # cloud-init may run without HOME; git config needs it
apt-get update
# libgl1/libglib2.0-0: OpenCV, pulled in by the OCR package
apt-get install -y git python3-venv python3-pip libgl1 libglib2.0-0

id checkflow || useradd --system --home-dir /opt/checkflow --shell /usr/sbin/nologin checkflow
git config --global --add safe.directory /opt/checkflow
if [ -d /opt/checkflow/.git ]; then
  git -C /opt/checkflow fetch --depth 1 origin '${git_ref}'
  git -C /opt/checkflow reset --hard FETCH_HEAD
else
  git clone --depth 1 --branch '${git_ref}' '${repo_url}' /opt/checkflow
fi
cd /opt/checkflow
[ -x .venv/bin/python ] || python3 -m venv .venv
.venv/bin/pip install --upgrade pip
.venv/bin/pip install -r requirements.txt
chown -R checkflow:checkflow /opt/checkflow

# Create the database and swap the stock admin/admin for the generated password.
sudo -u checkflow env CHECKFLOW_ADMIN_PW='${admin_password}' /opt/checkflow/.venv/bin/python - <<'PY'
import os
from checkflow import db, auth
db.init()
auth.seed_admin()
with db.conn() as c:
    uid = c.execute("SELECT id FROM users WHERE username = 'admin'").fetchone()[0]
auth.set_password(uid, os.environ["CHECKFLOW_ADMIN_PW"], min_len=8)
PY

cat > /etc/systemd/system/checkflow.service <<'UNIT'
[Unit]
Description=CheckFlow demo
After=network-online.target
Wants=network-online.target

[Service]
User=checkflow
WorkingDirectory=/opt/checkflow
Environment=PORT=${app_port}
ExecStart=/opt/checkflow/.venv/bin/python run.py --no-browser
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable checkflow
systemctl restart checkflow
echo "CheckFlow install finished"
INSTALL
chmod 700 /usr/local/bin/checkflow-install

/usr/local/bin/checkflow-install
